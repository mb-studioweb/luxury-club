jQuery(document).ready(function () {
    var scrollTopValue = "0";
    jQuery(window).scroll(function () {  // au scroll de la page - effetdu bouton
        if (jQuery('#scrollTopAnchor').length) {
            scrollTopValue = jQuery('#scrollTopAnchor').position().top;
        }
        var scrollTopTrigger = scrollTopValue + 50;
        if (jQuery(this).scrollTop() > scrollTopTrigger) {
            jQuery('#toTopBtn').fadeIn();
        } else {
            jQuery('#toTopBtn').fadeOut();
        }
    });
    jQuery('#toTopBtn').click(function () { // bouton retour top
        if (jQuery('#scrollTopAnchor').length) {
            scrollTopValue = jQuery('#scrollTopAnchor').position().top;
        }
        jQuery("html, body").animate({
            scrollTop: scrollTopValue
        }, 1000);
        return false;
    });

